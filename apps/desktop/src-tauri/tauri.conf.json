{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TypeVoice",
  "version": "0.1.2",
  "identifier": "com.typevoice.typevoice",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "TypeVoice",
        "width": 520,
        "height": 360,
        "minWidth": 480,
        "minHeight": 340,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'; connect-src 'self' https: http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:* wss:; media-src 'self' blob: data:; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "toolchain/bin/windows-x86_64/": "toolchain/windows-x86_64/",
      "toolchain/bin/linux-x86_64/": "toolchain/linux-x86_64/",
      "toolchain/bin/macos-aarch64/": "toolchain/macos-aarch64/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
